# 团子圆桌 — 复制为 .env.local 并填入真实 Key（勿提交到 Git）

# 小米 MiMo（联网搜索，建议官方 sk- Key）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 硅基流动 GLM-5.1
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek V4 Pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Emby 放映厅（仅服务端使用，勿加 NEXT_PUBLIC_ 前缀）
# EMBY_URL=https://emby.arya.beer
# EMBY_USER=admin
# EMBY_PASSWORD=

# 站点公网地址（企微 markdown_v2 嵌封面图会用到 /api/emby/image）
# SITE_ORIGIN=https://flynt.top

# 企业微信机器人（刮削入库 / Emby 新媒体自动通知，markdown_v2 + 封面）
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
# 可选：保护通知接口，Emby Webhook URL 需带 ?secret=xxx
# NOTIFY_SECRET=
